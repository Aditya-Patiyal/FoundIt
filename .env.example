# Copy to .env.local and fill in. Never commit .env.local.

# College email domain students sign in with (README §2). MUJ = muj.manipal.edu
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN="muj.manipal.edu"

# Supabase. Create a free project at https://supabase.com, then Settings → API Keys.
# Use the new-style keys: publishable (client) and secret (server-only).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Server-only key (sb_secret_...) — NEVER prefix with NEXT_PUBLIC_, never commit.
SUPABASE_SECRET_KEY=""
