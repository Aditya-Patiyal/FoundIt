# Copy to .env.local and fill in. Never commit .env.local.

# College email domain students sign in with (README §2, §16 open question).
# Example: muj.manipal.edu  — ASK THE OWNER for the real value.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN="[college email domain]"

# Supabase (added in Step 0/1). Create a free project at https://supabase.com
# and paste the values from Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only key — NEVER prefix with NEXT_PUBLIC_, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=""
